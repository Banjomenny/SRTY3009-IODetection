{
  "manifest_version": 3,
  "name": "IO Detector",
  "version": "1.0",
  "description": "Detects influence operation patterns in social media posts using NCI Engineered Reality scoring.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://truthsocial.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://reddit.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://truthsocial.com/*",
        "https://reddit.com/*"
      ],
      "js": ["platforms.js", "extractor.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IO Detector"
  }
}
